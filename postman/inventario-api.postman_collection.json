          "name": "Sin header X-API-Version (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/almacenes/{{sedeId}}/inventario"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
