{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "dev-server-home",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "url": "http://127.0.0.1:5173/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "product-registration-route-refresh",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "url": "http://127.0.0.1:5173/products/new",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
