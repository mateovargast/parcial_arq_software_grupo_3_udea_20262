          "expr": "sum(increase(cache_gets_total{job=\"inventario-api\", result=\"hit\"}[$__range])) / clamp_min(sum(increase(cache_gets_total{job=\"inventario-api\", result=~\"hit|miss\"}[$__range])), 1)",
